<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="충전 시작 시 앱 2개 분할화면 실행"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvRootStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="루트 상태 확인 중..."
            android:textSize="13sp"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="앱 A (먼저 실행 · 위/왼쪽)"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinnerAppA"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="앱 B (나중에 실행 · 아래/오른쪽)"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinnerAppB"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchAutoRun"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="충전 시작 시 자동 실행"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchPreferRoot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="루트 사용 가능하면 루트 방식 우선 사용"
            android:layout_marginBottom="24dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTestRun"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="지금 테스트 실행"
            android:layout_marginBottom="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAccessibilitySettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="접근성 권한 설정 열기 (루트 없을 때 필요)"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="※ 루트가 없으면 접근성 서비스로 분할화면 버튼을 자동으로 눌러 흉내냅니다. 제조사/런처마다 버튼 문구가 달라 동작하지 않을 수 있습니다. 그럴 땐 SplitScreenAccessibilityService.kt의 keywords 목록에 실제 기기 문구를 추가해 재빌드하세요."
            android:textSize="12sp"
            android:alpha="0.7" />

    </LinearLayout>
</ScrollView>
